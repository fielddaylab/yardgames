# theyardgames.org is retired: every URL 301s to Vault Learning Games (2026-10-05).
# Same file on production (theyardgames.org) and wwwtest (wwwtest.theyardgames.org); Plesk deploys it with the
# branch. See README.md. First match wins:
#   1. any path naming a game as a whole path segment -> that game's Vault page with the player open. This covers
#      game/<name>.html, game/<name>/iframe.html, beta/game/..., copies at other paths (nitrogen/iframe.html,
#      fieldday/yardgames/<name>/..., magnetism-Interactive/...) and mangled links like game/water.html&x=y;
#   2. everything else (including model, which has no Vault page) -> the Vault library filtered to Field Day Lab's
#      grade 5-8 science games,
#      except /.well-known/, which Plesk needs to renew the HTTPS certificate.
# mod_rewrite with QSD (drop query strings; Apache would append them after "#play") and NE (keep "#" as is).
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/\.well-known/
RewriteRule ^ - [L]
RewriteRule (^|/)bacteria([-_./&]|$) https://vaultlearninggames.org/antibiotic-resistance#play [R=301,L,NE,QSD]
RewriteRule (^|/)balloon([-_./&]|$) https://vaultlearninggames.org/hot-air-balloon#play [R=301,L,NE,QSD]
RewriteRule (^|/)carbon([-_./&]|$) https://vaultlearninggames.org/carbon-cycle-game#play [R=301,L,NE,QSD]
RewriteRule (^|/)crystal([-_./&]|$) https://vaultlearninggames.org/crystal-cave#play [R=301,L,NE,QSD]
RewriteRule (^|/)earthquake([-_./&]|$) https://vaultlearninggames.org/earthquake#play [R=301,L,NE,QSD]
RewriteRule (^|/)magnetism([-_./&]|$) https://vaultlearninggames.org/magnet-hunt#play [R=301,L,NE,QSD]
RewriteRule (^|/)nitrogen([-_./&]|$) https://vaultlearninggames.org/nitrogen-cycle-game#play [R=301,L,NE,QSD]
RewriteRule (^|/)water([-_./&]|$) https://vaultlearninggames.org/water-cycle-game#play [R=301,L,NE,QSD]
RewriteRule (^|/)waves([-_./&]|$) https://vaultlearninggames.org/wave-combinator#play [R=301,L,NE,QSD]
RewriteRule (^|/)wind([-_./&]|$) https://vaultlearninggames.org/wind-simulator#play [R=301,L,NE,QSD]
# game/iframe.html and game/index.html were stray copies of the balloon game.
RewriteRule ^(beta/)?game/(iframe|index)\.html$ https://vaultlearninggames.org/hot-air-balloon#play [R=301,L,NE,QSD]
RewriteRule ^ https://vaultlearninggames.org/?grade=5-8&subject=Science&maker=Field+Day+Lab#gg-filters [R=301,L,NE]
